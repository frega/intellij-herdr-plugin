<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.lassen.herdr</id>
    <name>Herdr</name>
    <vendor>Fredrik Lassen</vendor>
    <description><![CDATA[
        Runs <a href="https://herdr.dev">herdr</a> in its own tool window, separate from the built-in Terminal tool window,
        so it can be viewed alongside a regular shell or detached into its own floating window.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="herdr-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="dev.lassen.herdr.HerdrToolWindowFactory" id="Herdr" anchor="bottom" icon="/icons/ram.svg"/>
        <applicationService serviceImplementation="dev.lassen.herdr.settings.HerdrSettingsState"/>
        <applicationConfigurable
                parentId="tools"
                instance="dev.lassen.herdr.settings.HerdrSettingsConfigurable"
                id="dev.lassen.herdr.settings.HerdrSettingsConfigurable"
                displayName="Herdr"/>
        <notificationGroup id="Herdr" displayType="BALLOON"/>
        <projectCloseHandler implementation="dev.lassen.herdr.HerdrProjectCloseHandler"/>
    </extensions>

    <actions>
        <action id="dev.lassen.herdr.OpenHerdr" class="dev.lassen.herdr.HerdrOpenAction" text="Toggle Herdr"
                description="Shows and focuses the Herdr terminal, or hides it when it already has focus">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift H"/>
            <!-- Explicit Mac bindings: Option+Shift+H would type a character on macOS. -->
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt meta H"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt meta H"/>
        </action>
    </actions>
</idea-plugin>
